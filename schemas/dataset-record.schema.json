{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Negation focus dataset record",
  "description": "Schema for one line in majority_vote.jsonl or unanimous.jsonl.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "genre", "data", "label", "votes", "source"],
  "properties": {
    "id": {
      "type": "integer",
      "minimum": 1
    },
    "genre": {
      "enum": ["biography", "how_to_guide", "interview", "news", "travel_guide"]
    },
    "data": {
      "type": "string",
      "minLength": 1
    },
    "label": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "enum": ["a", "b", "c", "d", "e", "f", "x", "TIE"]
      }
    },
    "votes": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": false,
      "properties": {
        "a": {"type": "integer", "minimum": 1, "maximum": 3},
        "b": {"type": "integer", "minimum": 1, "maximum": 3},
        "c": {"type": "integer", "minimum": 1, "maximum": 3},
        "d": {"type": "integer", "minimum": 1, "maximum": 3},
        "e": {"type": "integer", "minimum": 1, "maximum": 3},
        "f": {"type": "integer", "minimum": 1, "maximum": 3},
        "x": {"type": "integer", "minimum": 1, "maximum": 3}
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "corpus",
        "repository",
        "revision",
        "amalgum_genre",
        "website",
        "amalgum_metadata",
        "text_license",
        "amalgum_annotation_license"
      ],
      "properties": {
        "corpus": {
          "const": "AMALGUM"
        },
        "repository": {
          "const": "https://github.com/gucorpling/amalgum"
        },
        "revision": {
          "type": ["string", "null"],
          "pattern": "^[0-9a-fA-F]{40}([0-9a-fA-F]{24})?$"
        },
        "amalgum_genre": {
          "enum": ["bio", "whow", "interview", "news", "voyage"]
        },
        "website": {
          "enum": ["Wikipedia", "wikiHow", "Wikinews", "Wikivoyage"]
        },
        "amalgum_metadata": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "title",
              "short_title",
              "date_collected",
              "url",
              "context_sentence_start_index_zero_based"
            ],
            "properties": {
              "id": {"type": "string", "minLength": 1},
              "title": {"type": "string", "minLength": 1},
              "short_title": {"type": "string", "minLength": 1},
              "author": {"type": "string", "minLength": 1},
              "date_collected": {"type": "string", "format": "date"},
              "date_created": {"type": "string", "format": "date"},
              "date_modified": {"type": "string", "format": "date"},
              "url": {"type": "string", "format": "uri"},
              "context_sentence_start_index_zero_based": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        },
        "text_license": {
          "type": "object",
          "additionalProperties": false,
          "required": ["identifier", "name", "url", "license_file"],
          "properties": {
            "identifier": {
              "enum": ["CC-BY-SA-3.0", "CC-BY-NC-SA-3.0", "CC-BY-2.5"]
            },
            "name": {"type": "string", "minLength": 1},
            "url": {"type": "string", "format": "uri"},
            "license_file": {"const": "LICENSE.txt"}
          }
        },
        "amalgum_annotation_license": {
          "type": "object",
          "additionalProperties": false,
          "required": ["identifier", "name", "url"],
          "properties": {
            "identifier": {"const": "CC-BY-4.0"},
            "name": {"const": "Creative Commons Attribution 4.0 International"},
            "url": {"const": "https://creativecommons.org/licenses/by/4.0/"}
          }
        }
      }
    }
  }
}
